#Reported model values used here: 25 starting bacteria, maximum 80 bacteria, zero initial BB170 signal, 60 signal-binding sites per bacterium, 120 polymer-binding sites per bacterium, 2 bacterial-binding sites and 5 signal-binding sites per polymer, KBS=0.5 with kBS+=0.001 and kBS−=0.002, Ksyn=0.05, degradation magnitude 0.01, luminescence scale 2500, BB170 BSc=15, BB170 signal-production rate 0.005, and 10 independent runs.
#Explicit assumptions required to make the approximate model runnable: one polymer object per starting bacterium at 0.05 mg/mL, scaled linearly with concentration; polymer forward rates 0.001 and reverse rates derived from k_off=k_on/K; each BB170 signal-production event adds one signal at propensity 0.005 × current bacteria; division times are triangular(5,000, 15,000, 25,000); signals and polymers occupy one well-mixed compartment. Random seeds are 101–110. These assumptions are not all specified by the paper.





import math
import random
import statistics
import matplotlib.pyplot as plt

# Reported values and explicit approximation assumptions.
INITIAL_BACTERIA = 25
MAX_BACTERIA = 80
B_SIGNAL_SITES_PER_B = 60
B_POLYMER_SITES_PER_B = 120
P_BACTERIA_SITES_PER_P = 2
P_SIGNAL_SITES_PER_P = 5
KBS_ON = 0.001
KBS_OFF = 0.002
KSYN = 0.05
KDEGRAD = 0.01
LUM_SCALE = 2500.0
BSC_BB170 = 15.0
BB170_SIGNAL_PRODUCTION_RATE = 0.005
ASSUMED_KPB_ON = 0.001
ASSUMED_KPS_ON = 0.001
POLYMERS_PER_BACTERIUM_PER_0_05_MG_ML = 1.0
END_TIME = 30_000.0
SAMPLE_INTERVAL = 100.0
SEEDS = tuple(range(101, 111))
AFFINITY_VALUES = (0.1, 0.5, 1.0, 5.0, 10.0)


def polymer_count_from_concentration(concentration_mg_ml, initial_bacteria=INITIAL_BACTERIA):
    """Assumption: 1 polymer per starting cell at 0.05 mg/mL, linearly scaled."""
    if concentration_mg_ml < 0:
        raise ValueError("Polymer concentration cannot be negative")
    raw = initial_bacteria * concentration_mg_ml / 0.05 * POLYMERS_PER_BACTERIUM_PER_0_05_MG_ML
    return int(math.floor(raw + 0.5))


def bb170_luminescence_per_bacterium(bs_express):
    delta_bs = 0.25 * (BSC_BB170 - bs_express)
    return LUM_SCALE * (1 - math.exp(delta_bs - 1) / (math.exp(delta_bs) + 1))


def update_expression(expr, bs_sense, dt):
    """Integrate the supplied synthesis/degradation ODE while BS_sense is fixed."""
    if dt <= 0:
        return expr
    if bs_sense > expr:
        return bs_sense + (expr - bs_sense) * math.exp(-KSYN * dt)
    if bs_sense < expr:
        return expr * math.exp(-KDEGRAD * dt)
    return expr


def run_bb170(concentration_mg_ml, kpb, kps, seed,
              end_time=END_TIME, sample_interval=SAMPLE_INTERVAL):
    """Run one well-mixed BB170 Gillespie approximation."""
    if end_time <= 0 or sample_interval <= 0:
        raise ValueError("end_time and sample_interval must be positive")
    rng = random.Random(seed)
    B = INITIAL_BACTERIA
    P = polymer_count_from_concentration(concentration_mg_ml, B)
    S_free = 0  # reported BB170 initial condition
    BS_bound = PS_bound = PB_bound = 0
    expr = 0.0
    t = 0.0

    kpb_on = 0.0 if (P == 0 or kpb == 0) else ASSUMED_KPB_ON
    kpb_off = 0.0 if (P == 0 or kpb == 0) else kpb_on / kpb
    kps_on = 0.0 if (P == 0 or kps == 0) else ASSUMED_KPS_ON
    kps_off = 0.0 if (P == 0 or kps == 0) else kps_on / kps

    division_times = [rng.triangular(5000.0, 25000.0, 15000.0) for _ in range(B)]
    next_sample = 0.0
    sample_times, light_values = [], []
    event_counts = {name: 0 for name in (
        "BS_on", "BS_off", "PS_on", "PS_off", "PB_on", "PB_off",
        "signal_production", "division"
    )}

    def record_until(cutoff):
        nonlocal expr, next_sample, t
        while next_sample <= cutoff and next_sample <= end_time:
            expr = update_expression(expr, BS_bound / max(B, 1), next_sample - t)
            t = next_sample
            sample_times.append(t)
            light_values.append(B * bb170_luminescence_per_bacterium(expr))
            next_sample += sample_interval

    while t < end_time:
        free_BS = max(0, B * B_SIGNAL_SITES_PER_B - BS_bound)
        free_PS = max(0, P * P_SIGNAL_SITES_PER_P - PS_bound)
        free_BP = max(0, B * B_POLYMER_SITES_PER_B - PB_bound)
        free_PB = max(0, P * P_BACTERIA_SITES_PER_P - PB_bound)
        events = [
            (KBS_ON * free_BS * S_free, "BS_on"),
            (KBS_OFF * BS_bound, "BS_off"),
            (kps_on * free_PS * S_free, "PS_on"),
            (kps_off * PS_bound, "PS_off"),
            (kpb_on * free_BP * free_PB, "PB_on"),
            (kpb_off * PB_bound, "PB_off"),
            (BB170_SIGNAL_PRODUCTION_RATE * B, "signal_production"),
        ]
        total = sum(rate for rate, _ in events)
        next_division = min(division_times) if division_times else math.inf
        if total <= 0:
            if next_division == math.inf:
                record_until(end_time)
                break
            event_time, event_name = next_division, "division"
        else:
            tau = -math.log(max(rng.random(), 1e-15)) / total
            stochastic_time = t + tau
            if next_division < stochastic_time:
                event_time, event_name = next_division, "division"
            else:
                threshold = rng.random() * total
                cumulative = 0.0
                event_name = events[-1][1]
                for rate, name in events:
                    cumulative += rate
                    if threshold <= cumulative:
                        event_name = name
                        break
                event_time = stochastic_time

        record_until(event_time)
        expr = update_expression(expr, BS_bound / max(B, 1), event_time - t)
        t = event_time
        if t >= end_time:
            break

        if event_name == "division":
            due = min(range(len(division_times)), key=division_times.__getitem__)
            division_times.pop(due)
            if B < MAX_BACTERIA:
                old_B = B
                B += 1
                expr *= old_B / B  # mean-state approximation; new daughter starts at zero expression
                event_counts["division"] += 1
                division_times.append(t + rng.triangular(5000.0, 25000.0, 15000.0))
                division_times.append(t + rng.triangular(5000.0, 25000.0, 15000.0))
            else:
                division_times.append(t + rng.triangular(5000.0, 25000.0, 15000.0))
            continue

        event_counts[event_name] += 1
        if event_name == "BS_on": S_free -= 1; BS_bound += 1
        elif event_name == "BS_off": S_free += 1; BS_bound -= 1
        elif event_name == "PS_on": S_free -= 1; PS_bound += 1
        elif event_name == "PS_off": S_free += 1; PS_bound -= 1
        elif event_name == "PB_on": PB_bound += 1
        elif event_name == "PB_off": PB_bound -= 1
        elif event_name == "signal_production": S_free += 1

    return {
        "times": sample_times,
        "light": light_values,
        "events": event_counts,
        "final_B": B,
        "final_state": {"B": B, "P": P, "S_free": S_free,
                       "BS_bound": BS_bound, "PS_bound": PS_bound,
                       "PB_bound": PB_bound},
        "seed": seed,
    }

print("BB170 initial signals: 0")
print("Polymer object counts at tested concentrations:", {
    c: polymer_count_from_concentration(c) for c in (0.05, 0.125, 0.25, 0.5)
})

POLYMER_CONCENTRATION = 0.25  # mg/mL
CONDITIONS = {
    "No polymer": (0.0, 0.0, 0.0),
    "P1 (KPB=5, KPS=0)": (POLYMER_CONCENTRATION, 5.0, 0.0),
    "P2 (KPB=0, KPS=0.1)": (POLYMER_CONCENTRATION, 0.0, 0.1),
    "P3 (KPB=5, KPS=10)": (POLYMER_CONCENTRATION, 5.0, 10.0),
}
BB170_RUNS = {
    name: [run_bb170(concentration, kpb, kps, seed) for seed in SEEDS]
    for name, (concentration, kpb, kps) in CONDITIONS.items()
}

plt.figure(figsize=(9, 5))
for name, runs in BB170_RUNS.items():
    times = runs[0]["times"]
    means = [statistics.mean(run["light"][i] for run in runs) for i in range(len(times))]
    sds = [statistics.stdev(run["light"][i] for run in runs) for i in range(len(times))]
    plt.plot(times, means, label=name)
    plt.fill_between(times, [m-s for m,s in zip(means,sds)],
                     [m+s for m,s in zip(means,sds)], alpha=0.18)
plt.xlabel("Time (a.u.)")
plt.ylabel("Total luminescence (approximation)")
plt.title(f"BB170 time courses at {POLYMER_CONCENTRATION:g} mg/mL; mean ± SD, n={len(SEEDS)}")
plt.legend()
plt.tight_layout()
plt.show()
BB170_TIMecourse_PLOT_DONE = True
print("Seeds:", SEEDS)

# If this cell is run by itself after setup, also show the BB170 luminescence time course.
if not globals().get("BB170_TIMecourse_PLOT_DONE", False):
    POLYMER_CONCENTRATION = 0.25  # mg/mL
    if "BB170_RUNS" not in globals():
        CONDITIONS = {
            "No polymer": (0.0, 0.0, 0.0),
            "P1 (KPB=5, KPS=0)": (POLYMER_CONCENTRATION, 5.0, 0.0),
            "P2 (KPB=0, KPS=0.1)": (POLYMER_CONCENTRATION, 0.0, 0.1),
            "P3 (KPB=5, KPS=10)": (POLYMER_CONCENTRATION, 5.0, 10.0),
        }
        BB170_RUNS = {
            name: [run_bb170(concentration, kpb, kps, seed) for seed in SEEDS]
            for name, (concentration, kpb, kps) in CONDITIONS.items()
        }
    plt.figure(figsize=(9, 5))
    for name, runs in BB170_RUNS.items():
        times = runs[0]["times"]
        means = [statistics.mean(run["light"][i] for run in runs) for i in range(len(times))]
        sds = [statistics.stdev(run["light"][i] for run in runs) for i in range(len(times))]
        plt.plot(times, means, label=name)
        plt.fill_between(times, [m-s for m,s in zip(means,sds)],
