    BB170_TIMecourse_PLOT_DONE = True

AFFINITY_CONCENTRATION = 0.25  # mg/mL
NO_POLYMER_CONTROLS = {
    seed: run_bb170(0.0, 0.0, 0.0, seed) for seed in SEEDS
}
fold_matrix = []
sd_matrix = []
for kpb in AFFINITY_VALUES:
    mean_row, sd_row = [], []
    for kps in AFFINITY_VALUES:
        replicate_folds = []
        for seed in SEEDS:
            with_polymer = run_bb170(AFFINITY_CONCENTRATION, kpb, kps, seed)
            no_polymer = NO_POLYMER_CONTROLS[seed]
            replicate_folds.append(with_polymer["light"][-1] / no_polymer["light"][-1])
        mean_row.append(statistics.mean(replicate_folds))
        sd_row.append(statistics.stdev(replicate_folds))
    fold_matrix.append(mean_row)
    sd_matrix.append(sd_row)

fig, ax = plt.subplots(figsize=(7, 5.5))
heat = ax.imshow(fold_matrix, origin="lower", cmap="viridis", aspect="auto")
ax.set_xticks(range(len(AFFINITY_VALUES)), labels=AFFINITY_VALUES)
ax.set_yticks(range(len(AFFINITY_VALUES)), labels=AFFINITY_VALUES)
ax.set_xlabel("Signal-binding affinity KPS (a.u.)")
ax.set_ylabel("Bacteria-binding affinity KPB (a.u.)")
ax.set_title(f"BB170 endpoint luminescence fold change at {AFFINITY_CONCENTRATION:g} mg/mL")
fig.colorbar(heat, ax=ax, label="Fold change vs no-polymer control")
for y in range(len(AFFINITY_VALUES)):
    for x in range(len(AFFINITY_VALUES)):
        ax.text(x, y, f"{fold_matrix[y][x]:.2f}", ha="center", va="center",
                color="white", fontsize=8)
fig.tight_layout()
plt.show()
print("Affinity values:", AFFINITY_VALUES)
print("Seeds:", SEEDS)

# BB170 time-varying concentration comparison (three panels, like the final MM32 plot).
# Run after the setup/simulator cell. This cell computes paired no-polymer controls
# and polymer runs using the same replicate seed for each comparison.
BB170_POLYMER_CONCENTRATIONS = (0.05, 0.125, 0.25, 0.5)  # mg/mL
BB170_POLYMERS = {
    "P1 (KPB=5, KPS=0)": (5.0, 0.0),
    "P2 (KPB=0, KPS=0.1)": (0.0, 0.1),
    "P3 (KPB=5, KPS=10)": (5.0, 10.0),
}

# One baseline per seed, reused for every polymer and concentration.
BB170_CONCENTRATION_CONTROLS = {
    seed: run_bb170(0.0, 0.0, 0.0, seed) for seed in SEEDS
}
bb170_fold_timecourses = {}
for polymer_name, (kpb, kps) in BB170_POLYMERS.items():
    bb170_fold_timecourses[polymer_name] = {}
    for concentration in BB170_POLYMER_CONCENTRATIONS:
        replicate_folds = []
        for seed in SEEDS:
            run = run_bb170(concentration, kpb, kps, seed)
            baseline = BB170_CONCENTRATION_CONTROLS[seed]
            # Convert each matched replicate to fold change before averaging.
            replicate_folds.append([
                value / control if control else float("nan")
                for value, control in zip(run["light"], baseline["light"])
            ])
        n_times = len(replicate_folds[0])
        means = [statistics.mean(row[i] for row in replicate_folds)
                 for i in range(n_times)]
        sds = [statistics.stdev(row[i] for row in replicate_folds)
               for i in range(n_times)]
        bb170_fold_timecourses[polymer_name][concentration] = {
            "times": run["times"], "mean": means, "sd": sds
        }

fig, axes = plt.subplots(1, 3, figsize=(16, 4.8), sharey=True)
colors = plt.cm.viridis([
    i / (len(BB170_POLYMER_CONCENTRATIONS) - 1)
    for i in range(len(BB170_POLYMER_CONCENTRATIONS))
])
for ax, (polymer_name, by_concentration) in zip(axes, bb170_fold_timecourses.items()):
    for color, concentration in zip(colors, BB170_POLYMER_CONCENTRATIONS):
        series = by_concentration[concentration]
        ax.plot(series["times"], series["mean"], color=color,
                label=f"{concentration:g} mg/mL")
        ax.fill_between(
            series["times"],
            [mean - sd for mean, sd in zip(series["mean"], series["sd"])],
            [mean + sd for mean, sd in zip(series["mean"], series["sd"])],
            color=color, alpha=0.10
        )
    ax.axhline(1.0, color="black", linewidth=0.8, linestyle="--")
    ax.set_title(polymer_name)
    ax.set_xlabel("Time (a.u.)")
    ax.set_xlim(0, END_TIME)
axes[0].set_ylabel("Fold change vs matched no-polymer control")
axes[-1].legend(title="Polymer concentration", bbox_to_anchor=(1.02, 1), loc="upper left")
fig.suptitle("BB170 concentration response — approximate well-mixed model")
fig.tight_layout()
plt.show()
print("BB170 polymer concentrations (mg/mL):", BB170_POLYMER_CONCENTRATIONS)
print("Seeds:", SEEDS)
